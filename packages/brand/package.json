{
  "name": "@tangle-network/brand",
  "version": "1.19.3",
  "description": "Tangle brand system \u2014 design tokens, logo, Tailwind v4 theme. Single source of truth for every Tangle app.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tangle-network/brand"
  },
  "bugs": {
    "url": "https://github.com/tangle-network/brand/issues"
  },
  "homepage": "https://github.com/tangle-network/brand",
  "sideEffects": [
    "./src/styles/*.css",
    "./dist/styles/*.css"
  ],
  "bin": {
    "tangle-drift": "./bin/tangle-drift.mjs"
  },
  "files": [
    "dist",
    "src",
    "bin/tangle-drift.mjs",
    "bin/drift-baseline.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": {
      "style": "./src/styles/index.css",
      "default": "./src/styles/index.css"
    },
    "./styles/index.css": "./src/styles/index.css",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/globals.css": "./src/styles/globals.css",
    "./styles/theme.css": "./src/styles/theme.css",
    "./styles/named-themes.css": "./src/styles/named-themes.css",
    "./styles/ladders.css": "./src/styles/ladders.css",
    "./styles/system.css": "./src/styles/system.css",
    "./styles/legacy-light.css": "./src/styles/legacy-light.css"
  },
  "scripts": {
    "build": "node scripts/gen-ladders.mjs --check && node scripts/gen-compat.mjs --check && node scripts/gen-palette.mjs --check && tsdown",
    "gen:ladders": "node scripts/gen-ladders.mjs",
    "gen:compat": "node scripts/gen-compat.mjs",
    "check:compat": "node scripts/gen-ladders.mjs --check && node scripts/gen-compat.mjs --check && node --test scripts/gen-compat.test.mjs",
    "check:drift": "node --test scripts/tangle-drift.test.mjs",
    "dev": "tsdown --watch",
    "gen:palette": "node scripts/gen-palette.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react": "^10.6.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "tangle",
    "design-system",
    "brand",
    "tokens",
    "tailwind"
  ]
}
