      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "default": "./dist/hooks.js"
    },
    "./sdk-hooks": {
      "types": "./dist/sdk-hooks.d.ts",
      "import": "./dist/sdk-hooks.js",
      "default": "./dist/sdk-hooks.js"
    },
    "./stores": {
      "types": "./dist/stores.d.ts",
      "import": "./dist/stores.js",
      "default": "./dist/stores.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "default": "./dist/utils.js"
    },
    "./tool-previews": {
      "types": "./dist/tool-previews.d.ts",
      "import": "./dist/tool-previews.js",
      "default": "./dist/tool-previews.js"
    },
    "./nav": {
      "types": "./dist/nav.d.ts",
      "import": "./dist/nav.js",
      "default": "./dist/nav.js"
    },
    "./redaction": {
      "types": "./dist/redaction.d.ts",
      "import": "./dist/redaction.js",
      "default": "./dist/redaction.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate-openui-validators.mjs --check && tsdown && node ../../scripts/validate-dist.mjs && node scripts/probe-openui-worker.mjs",
    "gen:openui-schema": "node scripts/generate-openui-validators.mjs",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@pierre/trees": "1.0.0-beta.6",
