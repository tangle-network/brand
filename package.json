{
  "name": "@tangle-network/design-system-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Tangle design-system foundation — brand tokens + generic UI components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tangle-network/brand"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r run --if-present build",
    "dev": "pnpm -r --parallel run --if-present dev",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @tangle-network/brand build && pnpm -r exec tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:package": "node scripts/package-smoke.mjs packages/ui && PACKAGE_PEER_OVERRIDES='{\"react-router\":\"^7\"}' node scripts/package-smoke.mjs packages/ui && PACKAGE_OMIT_OPTIONAL_PEERS='[\"@hocuspocus/provider\",\"@tiptap/core\",\"@tiptap/extension-collaboration\",\"@tiptap/extension-collaboration-caret\",\"@tiptap/react\",\"@tiptap/starter-kit\",\"yjs\"]' node scripts/package-smoke.mjs packages/ui",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4.2.2",
    "@tangle-network/brand": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.22.2"
  }
}
